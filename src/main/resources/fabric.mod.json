{
	"schemaVersion": 1,
	"id": "stealthpipe",
	"version": "${version}",
	"name": "StealthPipe",
	"description": "Minecraft mod that allows Open to LAN multiplayer to work on networks that block peer-to-peer connections and non-standard ports.",
	"authors": [
		"Me!"
	],
	"contact": {

	},
	"license": "CC0-1.0",
	"icon": "assets/stealthpipe/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.stealthpipe.StealthPipe"
		],
		"client": [
			"com.stealthpipe.StealthPipeClient"
		],
		"modmenu": [ "com.stealthpipe.ModMenuIntegration" ]
	},
	"mixins": [
		"stealthpipe.mixins.json",
		{
			"config": "stealthpipe.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}